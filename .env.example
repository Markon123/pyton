# Development defaults work without environment variables.
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# For deployment set DJANGO_DEBUG=0 and a unique secret generated securely.
# DJANGO_SECRET_KEY=
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-host.example
# Email defaults to .local/mail files. For real delivery configure SMTP securely.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=

# Optional PostgreSQL connection (URL-encode special characters in credentials).
# DATABASE_URL=postgresql://orenkod:change-me@db:5432/orenkod?sslmode=verify-full
# Public HTTPS origin for OIDC issuer and certificate QR links.
# PUBLIC_BASE_URL=https://your-host.example
# Enable forwarded-proto only behind a trusted sanitizing reverse proxy.
# TRUST_PROXY_HEADERS=1
# Comma-separated approved HTTPS webhook destinations; no arbitrary addresses.
# INTEGRATION_WEBHOOK_ALLOWED_HOSTS=hooks.partner.example
# Docker Compose only: use a unique URL-safe database password for production.
# POSTGRES_PASSWORD=
# FSP_SEED_DEMO=0
